# With an even number of sites the two middle sites fire together, each excited from its own side.
# Reference: the same network integrated independently (complex arithmetic, LSODA).
title Two pulses meeting in a chain of 16
sites 16
path 1 16 kappa=0.06
kick 1 amplitude=2
kick 16 amplitude=2
run 1200
expect total 16
expect last 133.70026 0.003
expect count 1 1
expect arrival 1 12.96038 0.003
expect peak 1 58.059000 2e-4
expect count 3 1
expect arrival 3 48.19817 0.003
expect peak 3 56.712157 2e-4
expect count 4 1
expect arrival 4 65.44912 0.003
expect peak 4 56.707628 2e-4
