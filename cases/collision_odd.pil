# Pulses launched from both ends meet in the middle and annihilate: each site fires once, the one in the middle from both sides at once, and nothing passes through.
# Reference: the same network integrated independently (complex arithmetic, LSODA).
title Two pulses meeting in a chain of 15
sites 15
path 1 15 kappa=0.06
kick 1 amplitude=2
kick 15 amplitude=2
run 1200
expect total 15
expect last 124.78794 0.003
expect count 1 1
expect arrival 1 12.96038 0.003
expect peak 1 58.059000 2e-4
expect count 3 1
expect arrival 3 48.19817 0.003
expect peak 3 56.712156 2e-4
expect count 4 1
expect arrival 4 65.44918 0.003
expect peak 4 56.707662 2e-4
expect count 6 1
expect arrival 6 99.89333 0.003
expect peak 6 56.731201 2e-4
expect count 7 1
expect arrival 7 118.68317 0.003
expect peak 7 55.685572 2e-4
expect count 9 1
expect arrival 9 118.68317 0.003
expect peak 9 55.685572 2e-4
expect count 10 1
expect arrival 10 99.89333 0.003
expect peak 10 56.731201 2e-4
expect count 12 1
expect arrival 12 65.44918 0.003
expect peak 12 56.707662 2e-4
expect count 13 1
expect arrival 13 48.19817 0.003
expect peak 13 56.712156 2e-4
expect count 15 1
